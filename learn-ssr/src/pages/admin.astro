---
// Server-rendered (not pre-built) so it can read env vars on each request.
export const prerender = false;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin — learn.ipexiq.com</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 520px; margin: 4rem auto; padding: 0 1rem; color: #222; }
      input, button { font-size: 1rem; padding: 0.6rem 0.8rem; border: 1px solid #ccc; border-radius: 6px; }
      input { width: 100%; box-sizing: border-box; margin-bottom: 1rem; }
      button { background: #0a66c2; color: #fff; border: none; cursor: pointer; }
      button:disabled { opacity: 0.6; cursor: wait; }
      .row { margin-top: 0.75rem; padding: 0.75rem; border-radius: 6px; font-family: monospace; font-size: 0.9rem; }
      .ok { background: #e6f7ed; color: #0a6b2e; }
      .err { background: #fbe6e6; color: #8a1f1f; }
      h1 { margin-bottom: 0.25rem; }
      p.sub { color: #666; margin-top: 0; }
    </style>
  </head>
  <body>
    <h1>Rebuild learn.ipexiq.com</h1>
    <p class="sub">Pulls the latest <code>/learn/*</code> chapters from the main app and republishes the SSR mirror. Takes ~30 seconds.</p>

    <label for="token">Admin token</label>
    <input id="token" type="password" autocomplete="off" placeholder="Paste ADMIN_TOKEN" />
    <button id="go" type="button">Rebuild now</button>
    <div id="result"></div>

    <script is:inline>
      const btn = document.getElementById('go');
      const tok = document.getElementById('token');
      const out = document.getElementById('result');
      btn.addEventListener('click', async () => {
        out.innerHTML = '';
        btn.disabled = true;
        btn.textContent = 'Triggering…';
        try {
          const r = await fetch('/api/rebuild', {
            method: 'POST',
            headers: { 'x-admin-token': tok.value || '' },
          });
          const text = await r.text();
          out.innerHTML = `<div class="row ${r.ok ? 'ok' : 'err'}">${r.status} — ${text.replace(/</g, '&lt;')}</div>`;
        } catch (e) {
          out.innerHTML = `<div class="row err">${String(e)}</div>`;
        } finally {
          btn.disabled = false;
          btn.textContent = 'Rebuild now';
        }
      });
    </script>
  </body>
</html>